# Robot Identity & Authentication
ROBOT_ID=ROBOT-ALPHA-01
ROBOT_NAME=Autonomous Scout Rover Alpha
ROBOT_API_KEY=ghr_secret_alpha_key_2026
GREENHOUSE_ID=GH-NORTH-01

# Backend Server URL (LAN IP or domain of server computer)
# Example: http://192.168.1.100:5000 or http://localhost:5000
BACKEND_URL=http://localhost:5000

# SQLite Local Offline Queue Database
SQLITE_DB_PATH=data/robot_offline.db
IMAGE_STORAGE_DIR=images/

# Hardware Drivers (Set to false or mock when developing without physical sensors)
MOCK_HARDWARE=true

# RS-485 Modbus NPK Soil Sensor Configuration
# Specific Modbus parameters must match the manufacturer datasheet
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_BYTESIZE=8
MODBUS_SLAVE_ID=1
MODBUS_TIMEOUT=1.0

# Register Addresses (To be configured according to exact manufacturer datasheet)
# Example defaults for standard 7-in-1 / 3-in-1 NPK probes (0x001E, 0x001F, 0x0020)
REG_NITROGEN=30
REG_PHOSPHORUS=31
REG_POTASSIUM=32

# Camera Settings
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080
CAMERA_WARMUP_SEC=2.0

# AI Leaf Disease Detection Model
# Path to trained .tflite or .onnx model file (leave empty if not yet trained)
AI_MODEL_PATH=
AI_LABELS_PATH=
AI_CONFIDENCE_THRESHOLD=0.65

# Inspection Loop Interval (seconds)
INSPECTION_INTERVAL_SEC=30
HEARTBEAT_INTERVAL_SEC=15
