# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example local: mongodb://localhost:27017/greenhouse_robot
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/greenhouse_robot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/greenhouse_robot

# JWT Secret for User Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Robot API Authentication
# Pre-shared or hashed robot secret for initial robot registration or authentication
ROBOT_API_KEY_SECRET=replace_with_a_secure_robot_api_secret_key

# CORS Allowed Origins (Comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Uploads Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Robot Heartbeat / Offline Threshold (seconds)
ROBOT_OFFLINE_THRESHOLD_SEC=60
ROBOT_SWEEP_INTERVAL_SEC=30
